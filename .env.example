# Copiá este archivo como .env.local para desarrollo.
# En Vercel / Railway / Render lo cargás como variables de entorno.

# OBLIGATORIO en producción: URL de PostgreSQL.
# Opciones gratis: Vercel Postgres, Neon, Supabase, Railway.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/base

# OPCIONAL: contraseña para tu perfil (ytk1).
# Si no la ponés, por defecto es "alexxx".
PANEL_PASSWORD=alexxx

# OPCIONAL: si usas un dominio propio (ej: ytk1.web.app), mapealo a tu slug:
# DOMAIN_MAP='{"ytk1.web.app":"ytk1"}'
SESSION_SECRET=pon-una-frase-larga-y-aleatoria
